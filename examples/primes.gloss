feature is_prime
  needs n as number
  if n is less than 2
    give no
  set d to 2
  repeat while d * d is at most n
    if remainder of n by d is 0
      give no
    add 1 to d
  give yes

feature start
  set found to 0
  for each n from 1 to 50
    if is_prime with n
      show n
      add 1 to found
  show found, " primes up to 50"
