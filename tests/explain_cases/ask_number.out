Explain ask_number.gloss for x86-64 Linux

feature start (line 1)
  answer: text, created on line 2, at [rbp-8]
  n: number, created on line 3, at [rbp-16]

line 1: feature start
    push rbp
    mov rbp, rsp
    sub rsp, 32
    mov [rbp-32], rcx
    xor rdx, rdx
    mov [rbp-8], rdx                ; answer
    mov [rbp-16], rdx               ; n
    mov [rbp-24], rdx
line 2: ask "How many? " into answer
    lea rax, [rip+text_0]           ; "How many? "
    push rax
    movabs rax, 2
    push rax
    call ask
    add rsp, 16
    mov [rbp-8], rax                ; answer
line 3: set n to answer as number
    mov rax, [rbp-8]                ; answer
    mov [rbp-24], rax
    push rax
    call parse_number
    add rsp, 8
    movabs rcx, 0
    cmp rax, rcx
    jne .L0                         ; failure 5: "…" is not a number (answer as number)
    lea rax, [rip+num_buf]
    mov rax, [rax+0]
    mov [rbp-16], rax               ; n
line 4: show n
    mov rax, [rbp-16]               ; n
    push rax
    call out_number
    add rsp, 8
    lea rax, [rip+text_1]           ; "\u{000A}"
    push rax
    call out_text
    add rsp, 8
line 1: feature start (continued)
    mov rcx, [rbp-32]
    mov rsp, rbp
    pop rbp
    ret
failure 5, line 3
  .L0:
    movabs rax, 3
    push rax
    movabs rax, 5
    push rax
