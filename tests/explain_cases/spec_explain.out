Explain spec_explain.gloss for x86-64 Linux

feature add_to_total (line 1)
  price: number, input 1, at [rbp+16]
  total: number, created on line 3, at [rbp-8]

line 1: feature add_to_total
    push rbp
    mov rbp, rsp
    sub rsp, 16
    mov [rbp-16], rcx
    xor rdx, rdx
    mov [rbp-8], rdx                ; total
line 3: set total to 0
    movabs rax, 0
    mov [rbp-8], rax                ; total
line 4: add price to total
    mov rax, [rbp+16]               ; price
    mov rcx, rax
    mov rax, [rbp-8]                ; total
    add rax, rcx
    jo .L0                          ; failure 4: a number went out of range (add price to total)
    mov [rbp-8], rax                ; total
line 5: give total
    mov rax, [rbp-8]                ; total
    mov rcx, [rbp-16]
    mov rsp, rbp
    pop rbp
    ret
line 1: feature add_to_total (continued)
    call flush
    lea rax, [rip+text_0]           ; "internal error: feature add_to…"
    push rax
    call err_text
    add rsp, 8
    call fail_end
