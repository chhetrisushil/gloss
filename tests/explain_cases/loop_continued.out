Explain loop_continued.gloss for x86-64 Linux

feature start (line 1)
  n: number, created on line 2, at [rbp-8]

line 1: feature start
    push rbp
    mov rbp, rsp
    sub rsp, 16
    mov [rbp-16], rcx
    xor rdx, rdx
    mov [rbp-8], rdx                ; n
line 2: set n to 0
    movabs rax, 0
    mov [rbp-8], rax                ; n
  .L0:
line 3: repeat while n is less than 2
    mov rax, [rbp-8]                ; n
    push rax
    movabs rax, 20000
    mov rcx, rax
    pop rax
    cmp rax, rcx
    setl al
    and rax, 255
    movabs rcx, 0
    cmp rax, rcx
    je .L1
line 4: add 1 to n
    movabs rax, 10000
    mov rcx, rax
    mov rax, [rbp-8]                ; n
    add rax, rcx
    jo .L2                          ; failure 4: a number went out of range (add 1 to n)
    mov [rbp-8], rax                ; n
line 3: repeat while n is less than 2 (continued)
    jmp .L0
  .L1:
line 1: feature start (continued)
    mov rcx, [rbp-16]
    mov rsp, rbp
    pop rbp
    ret
failure 4, line 4
  .L2:
    movabs rax, 4
    push rax
    movabs rax, 4
    push rax
    call fail_begin
    add rsp, 16
    lea rax, [rip+text_0]           ; "a number went out of range ("
    push rax
    call err_text
    add rsp, 8
    lea rax, [rip+text_1]           ; "add 1 to n"
    push rax
    call err_text
    add rsp, 8
    lea rax, [rip+text_2]           ; ")"
    push rax
    call err_text
    add rsp, 8
    call fail_end

