Explain repeat_while.gloss for x86-64 Linux

feature start (line 1)
  n: number, created on line 2, at [rbp-8]

line 1: feature start
    push rbp
    mov rbp, rsp
    sub rsp, 16
    mov [rbp-16], rcx
    xor rdx, rdx
    mov [rbp-8], rdx                ; n
line 2: set n to 3
    movabs rax, 30000
    mov [rbp-8], rax                ; n
line 3: repeat while n is greater than 0
  .L0:
    mov rax, [rbp-8]                ; n
    push rax
    movabs rax, 0
    mov rcx, rax
    pop rax
    cmp rax, rcx
    setg al
    and rax, 255
    movabs rcx, 0
    cmp rax, rcx
    je .L1
line 4: show n
    mov rax, [rbp-8]                ; n
    push rax
    call out_number
    add rsp, 8
    lea rax, [rip+text_0]           ; "\u{000A}"
    push rax
    call out_text
    add rsp, 8
line 5: subtract 1 from n
    movabs rax, 10000
    mov rcx, rax
    mov rax, [rbp-8]                ; n
    sub rax, rcx
    jo .L2                          ; failure 4: a number went out of range (subtract 1 from n)
    mov [rbp-8], rax                ; n
line 3: repeat while n is greater than 0 (continued)
    jmp .L0
line 6: show "done"
  .L1:
    lea rax, [rip+text_1]           ; "done"
    push rax
    call out_text
    add rsp, 8
    lea rax, [rip+text_0]           ; "\u{000A}"
    push rax
    call out_text
    add rsp, 8
line 1: feature start (continued)
    mov rcx, [rbp-16]
    mov rsp, rbp
    pop rbp
    ret
failure 4, line 5
  .L2:
    movabs rax, 5
    push rax
    movabs rax, 4
    push rax
    call fail_begin
    add rsp, 16
    lea rax, [rip+text_2]           ; "a number went out of range ("
    push rax
    call err_text
    add rsp, 8
    lea rax, [rip+text_3]           ; "subtract 1 from n"
    push rax
    call err_text
    add rsp, 8
    lea rax, [rip+text_4]           ; ")"
    push rax
    call err_text
    add rsp, 8
    call fail_end

