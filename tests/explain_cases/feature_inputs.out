    push rax
    movabs rax, 20000
    push rax
    lea rdx, [rsp-88]
    mov rsi, [rip+stack_limit]
    cmp rdx, rsi
    jb .L0                          ; failure 10: calls nested too deep (add_up)
    call f_add_up
    add rsp, 16
