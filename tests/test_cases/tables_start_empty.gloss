record Expense
  name as text
  amount as number

table expenses of Expense in "expenses.csv"

feature start
  show 1

test "a table starts empty and grows"
  expect count of expenses is 0
  append Expense with name "Lunch", amount 120 to expenses
  expect count of expenses is 1

test "clear empties it again"
  append Expense with name "Lunch", amount 120 to expenses
  clear expenses
  append Expense with name "Bus", amount 40 to expenses
  append Expense with name "Tea", amount 10 to expenses
  expect count of expenses is 2
